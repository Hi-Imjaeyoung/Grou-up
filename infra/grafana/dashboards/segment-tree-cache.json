{
  "uid": "grouup-segment-tree",
  "title": "GrouUp ② 세그먼트 트리 캐시 재측정",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "HikariCP 커넥션 (active / idle / pending)",
      "type": "timeseries",
      "datasource": null,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle",
          "legendFormat": "idle",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending",
          "legendFormat": "pending",
          "refId": "C"
        },
        {
          "expr": "hikaricp_connections_max",
          "legendFormat": "max",
          "refId": "D"
        }
      ]
    },
    {
      "id": 2,
      "title": "Connection Acquire 시간",
      "type": "timeseries",
      "datasource": null,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "hikaricp_connections_acquire_seconds_max",
          "legendFormat": "max",
          "refId": "A"
        },
        {
          "expr": "rate(hikaricp_connections_acquire_seconds_sum[15s]) / rate(hikaricp_connections_acquire_seconds_count[15s])",
          "legendFormat": "avg",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Connection Usage 시간",
      "type": "timeseries",
      "datasource": null,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "hikaricp_connections_usage_seconds_max",
          "legendFormat": "max",
          "refId": "A"
        },
        {
          "expr": "rate(hikaricp_connections_usage_seconds_sum[15s]) / rate(hikaricp_connections_usage_seconds_count[15s])",
          "legendFormat": "avg",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP 응답 시간 (uri별 max)",
      "type": "timeseries",
      "datasource": null,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "http_server_requests_seconds_max{uri=~\"/api/campaign/totalAnalysisData.*\"}",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "JVM 스레드 상태",
      "type": "timeseries",
      "datasource": null,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "jvm_threads_states_threads",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "CPU 사용률",
      "type": "timeseries",
      "datasource": null,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "process_cpu_usage",
          "legendFormat": "process",
          "refId": "A"
        },
        {
          "expr": "system_cpu_usage",
          "legendFormat": "system",
          "refId": "B"
        }
      ]
    }
  ],
  "tags": [
    "grouup"
  ]
}